{
  "name": "platform-timer-web",
  "version": "3.0.0",
  "private": true,
  "description": "Platform Timer — professional web-based event timer with presenter view, cloud sync, and a freemium paywall.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "wrangler pages dev -- npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=mount-zion-timer",
    "create-admin": "node scripts/createAdmin.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:no-payment": "playwright test --grep-invert @payment",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.453.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "stripe": "^17.2.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@vitejs/plugin-react": "^4.3.2",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^7.0.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^3.90.0"
  }
}
