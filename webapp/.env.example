# ── Frontend (exposed to the browser — must be prefixed VITE_) ─────────────
# Backend secrets (Stripe, Supabase service role) go in .dev.vars, not here —
# see .dev.vars.example. This file is Vite-only.

# Supabase project URL & anon (public) key. From Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key. From Stripe dashboard > Developers > API keys.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Base URL of the API — Functions are served from the same origin as the site
# (both in `wrangler pages dev` and in production), so this stays as /api.
VITE_API_BASE_URL=/api

# Free-tier timer cap. Change here if you ever want to offer a different limit.
VITE_FREE_TIMER_LIMIT=5

# One-time upgrade price shown in the UI (display only — the real amount lives in Stripe).
VITE_UPGRADE_PRICE_LABEL=€20
